{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Com Client",
  "version": "0.6.3",
  "identifier": "net.comclient.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Com Client",
        "width": 1180,
        "height": 720,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "backgroundColor": "#07050c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Com Client",
    "shortDescription": "Com Client Launcher",
    "longDescription": "Installs, updates and starts Com Client for Minecraft.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "installer/uninstall.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MTNDOTI2OUUyOTU4RjMKUldUeldDbWVKc2tUZU0vRUg4dUlXanBCVllFSlplWVowWXcvK2FTTlBFdStRYmplbVR4Yy9lK3AK",
      "endpoints": [
        "https://github.com/troxytele/com-client-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
